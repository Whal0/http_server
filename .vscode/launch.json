{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug Current Module",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        
        {
            "name": "Python Debugger: http pytest debug",
            "type": "debugpy",
            "request": "launch",
            "module" : "pytest",
            "console": "integratedTerminal",
            "env": {"PYTHONPATH": "${workspaceFolder}"}
        },

        {
            "name": "Python Debugger: http debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {"PYTHONPATH": "${workspaceFolder}"}
        }
    ]
}